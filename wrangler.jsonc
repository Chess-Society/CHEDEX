{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chedex",
  "account_id": "85a3239ece7244f9c2db16df066c4484",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "chedex.app", "custom_domain": true }],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none" },
  "vars": {
    "NODE_ENV": "production",
    "APP_URL": "https://chedex.app",
    "LICHESS_CLIENT_ID": "chedex.app"
  },
  "triggers": { "crons": ["17 * * * *"] },
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } }
}
