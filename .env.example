PORT=3000
APP_URL=http://127.0.0.1:3000
LICHESS_CLIENT_ID=chedex-local
LICHESS_ADMIN_IDS=andresli
# Activa únicamente en desarrollo local. Nunca en producción.
ENABLE_DEMO=true
# Configura ambas variables para usar tu base libSQL de Turso.
# La URL del panel app.turso.tech no es una URL de conexión.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Apple Wallet: mantener vacío hasta disponer de certificados válidos.
# Se exige APP_URL con HTTPS. Las rutas apuntan a archivos privados en el servidor.
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_WWDR_CERT_PATH=
APPLE_SIGNER_CERT_PATH=
APPLE_SIGNER_KEY_PATH=
APPLE_SIGNER_KEY_PASSPHRASE=
# Alternativa para Cloudflare: secretos PEM completos, nunca variables públicas.
# APPLE_WWDR_CERT, APPLE_SIGNER_CERT, APPLE_SIGNER_KEY
