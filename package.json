{
  "name": "chedex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch server/local.js",
    "start": "node --env-file-if-exists=.env server/local.js",
    "test": "node --test",
    "check": "node scripts/check.mjs",
    "deploy:check": "wrangler deploy --dry-run --outdir .worker-build",
    "deploy": "wrangler deploy",
    "legal:build": "node scripts/render-legal.mjs",
    "data:maintain": "node scripts/maintain-data.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.156.1"
  }
}
