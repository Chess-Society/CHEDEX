{
  "name": "chedex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch server/local.js",
    "start": "node --env-file-if-exists=.env server/local.js",
    "test": "node --test",
    "check": "node --check server/index.js && node --check server/domain.js && node --check server/auth.js && node --check server/apple-wallet.js && node --check public/app.js",
    "deploy:check": "wrangler deploy --dry-run --outdir .worker-build",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "passkit-generator": "^3.7.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4"
  },
  "overrides": {
    "passkit-generator": {
      "joi": "17.13.9"
    }
  },
  "devDependencies": {
    "node-forge": "^1.4.2",
    "wrangler": "^4.156.1"
  }
}
